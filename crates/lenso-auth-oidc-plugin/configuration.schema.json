{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "signing_key_secret",
    "code_pepper_secret",
    "issuer",
    "jwks",
    "client_id",
    "redirect_uris",
    "authorize_callers",
    "audience",
    "code_ttl_seconds",
    "token_ttl_seconds"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "database_url_secret": {
      "type": "string",
      "default": "",
      "maxLength": 256
    },
    "signing_key_secret": {
      "type": "string"
    },
    "code_pepper_secret": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "jwks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kty",
              "use",
              "alg",
              "n",
              "e"
            ],
            "properties": {
              "kty": {
                "const": "RSA"
              },
              "kid": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "use": {
                "const": "sig"
              },
              "alg": {
                "const": "RS256"
              },
              "n": {
                "type": "string",
                "minLength": 342,
                "maxLength": 1366
              },
              "e": {
                "type": "string",
                "minLength": 2,
                "maxLength": 11
              }
            }
          }
        }
      }
    },
    "key_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "redirect_uris": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authorize_callers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "code_ttl_seconds": {
      "type": "integer"
    },
    "token_ttl_seconds": {
      "type": "integer"
    },
    "d1_binding": {
      "type": "string",
      "default": "",
      "maxLength": 128
    }
  }
}
