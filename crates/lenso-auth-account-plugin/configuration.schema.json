{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "issuer",
    "assertion_public_key",
    "assertion_signing_key_secret",
    "token_pepper_secret",
    "assertion_ttl_seconds"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "assertion_public_key": {
      "type": "string"
    },
    "database_url_secret": {
      "type": "string"
    },
    "d1_binding": {
      "type": "string"
    },
    "assertion_signing_key_secret": {
      "type": "string"
    },
    "token_pepper_secret": {
      "type": "string"
    },
    "assertion_ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "admin_callers": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "delegation_callers": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "credential_state_callers": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "management_session_ceiling": {
      "if": {
        "type": "null"
      },
      "then": {
        "type": "null"
      },
      "else": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deployment",
          "permissions",
          "resource_scopes"
        ],
        "properties": {
          "deployment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "resource_scopes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      }
    },
    "scoped_delegation_targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "storage_ref": {
      "type": "string",
      "default": ""
    },
    "managed_sessions": {
      "default": null,
      "if": {
        "type": "null"
      },
      "then": {
        "type": "null"
      },
      "else": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy",
          "issue_callers",
          "renew_callers"
        ],
        "properties": {
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "idle_timeout_seconds",
              "absolute_timeout_seconds",
              "renew_interval_seconds"
            ],
            "properties": {
              "idle_timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2592000
              },
              "absolute_timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7776000
              },
              "renew_interval_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1296000
              }
            }
          },
          "issue_callers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "renew_callers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    }
  }
}
