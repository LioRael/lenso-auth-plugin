{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admin_callers": {
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]+(?:/[A-Za-z0-9._:-]+)?$"
      },
      "type": "array"
    },
    "assertion_public_key": {
      "type": "string"
    },
    "assertion_signing_key_secret": {
      "type": "string"
    },
    "assertion_ttl_seconds": {
      "minimum": 0,
      "type": "integer"
    },
    "database_url_secret": {
      "type": "string"
    },
    "delegation_callers": {
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]+(?:/[A-Za-z0-9._:-]+)?$"
      },
      "type": "array"
    },
    "issuer": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "token_pepper_secret": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "issuer",
    "assertion_public_key",
    "database_url_secret",
    "assertion_signing_key_secret",
    "token_pepper_secret",
    "assertion_ttl_seconds"
  ],
  "type": "object"
}
