{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["issuer", "public_key", "assertion_max_ttl_seconds", "caller_instances", "deployment", "access_scope", "account_instance"],
  "properties": {
    "issuer": {"type":"string", "minLength":1, "maxLength":256},
    "public_key": {"type":"string", "minLength":1},
    "assertion_max_ttl_seconds": {"type":"integer", "minimum":1, "maximum":3600},
    "caller_instances": {"type":"array", "minItems":1, "maxItems":64, "uniqueItems":true, "items":{"type":"string", "minLength":1, "maxLength":256}},
    "deployment": {"type":"string", "minLength":1, "maxLength":256},
    "account_instance": {"type":"string", "minLength":1, "maxLength":256},
    "access_scope": {"type":"object", "additionalProperties":false, "required":["kind","id"], "properties":{"kind":{"type":"string","minLength":1,"maxLength":256},"id":{"type":"string","minLength":1,"maxLength":256}}},
    "allowed_mutations": {"type":"array", "default":[], "maxItems":2, "uniqueItems":true, "items":{"type":"string", "enum":["set_subject_status","revoke_session"]}}
  }
}
